#!/usr/bin/env bash
# preinstall: checks that the Pi can run this release and creates the dog users and groups.
# robotctl update apply runs it as root before the current symlink changes, so a failure changes nothing.
set -euo pipefail

# scripts/install-pi.sh reads this line, so the list is in one place.
APT_PACKAGES=(python3-venv python3-opencv python3-numpy python3-evdev alsa-utils)

# fail prints a reason and stops the hook.
fail() {
	echo "preinstall: $*" >&2
	exit 1
}

missing=()
for pkg in "${APT_PACKAGES[@]}"; do
	dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" || missing+=("$pkg")
done
((${#missing[@]} == 0)) || fail "missing apt packages: ${missing[*]}; run: sudo apt-get install ${missing[*]}"

# mediad needs cv2.aruco.ArucoDetector (OpenCV 4.7 or later), which Debian 13 Trixie has.
python3 -c 'import cv2; cv2.aruco.ArucoDetector' 2>/dev/null ||
	fail "python3-opencv has no cv2.aruco.ArucoDetector; use Raspberry Pi OS based on Debian 13 Trixie"

# Each command runs only when its item is absent, so the hook is idempotent.
for group in dog doglink dialout video audio input; do
	getent group "$group" >/dev/null || groupadd --system "$group"
done
id -u doglink >/dev/null 2>&1 || useradd --system --gid doglink --home-dir /nonexistent --shell /usr/sbin/nologin doglink
id -u dog >/dev/null 2>&1 || useradd --system --gid dog --home-dir /var/lib/dog --shell /usr/sbin/nologin dog
usermod --append --groups dialout,video,audio,input,doglink dog
if id -u robot >/dev/null 2>&1; then
	usermod --append --groups dog robot
fi
