#!/usr/bin/env bash
# postinstall: installs the units, tmpfiles, modules and launcher of this release and the absent /etc/dog files.
# robotctl update apply runs it as root after the current symlink points at this release, and again on a rollback.
# It never overwrites a file in /etc/dog and never starts a daemon; robotctl restarts dog.target after it.
set -euo pipefail

release=$(cd "$(dirname "$0")/.." && pwd)
units="$release/deploy/pi"

for unit in dog.target robotd.service mediad.service padd.service linkd.service; do
	install -m 0644 "$units/$unit" "/etc/systemd/system/$unit"
done
install -m 0644 "$units/dog-tmpfiles.conf" /etc/tmpfiles.d/dog.conf
install -m 0644 "$units/dog-modules.conf" /etc/modules-load.d/dog.conf
install -m 0755 "$units/robotctl" /usr/local/bin/robotctl
systemctl daemon-reload
systemd-tmpfiles --create /etc/tmpfiles.d/dog.conf

# /etc/dog is setgid group dog and group-writable, so robotctl (run by a member of dog) can replace registry.json.
install -d -o root -g dog -m 2775 /etc/dog

# seed copies a template to /etc/dog only when the target is absent, with the given owner and mode.
seed() {
	local src=$1 dst=$2 owner=$3 mode=$4
	if [[ ! -e $dst ]]; then
		install -o "${owner%:*}" -g "${owner#*:}" -m "$mode" "$src" "$dst"
	fi
}
seed "$release/config/dog.toml" /etc/dog/dog.toml root:dog 0644
seed "$release/config/registry.json" /etc/dog/registry.json root:dog 0664
seed "$units/link.env.example" /etc/dog/link.env doglink:doglink 0600
seed "$units/console.env.example" /etc/dog/console.env root:dog 0640

systemctl enable dog.target
