# hub.env: settings and secrets of doghub.service. Install it as /etc/doghub/hub.env (root:root, mode 0600).
# scripts/deploy-hub.sh fills DEVICE_TOKEN, TOOLS_TOKEN and HERMES_API_KEY with new random values on the first run.
# DEVICE_TOKEN must also go into /etc/dog/link.env on the Pi.
# TOOLS_TOKEN and HERMES_API_KEY must be the same as TOOLS_TOKEN and API_SERVER_KEY in ~hermes/.hermes/.env.
DEVICE_TOKEN=
TOOLS_TOKEN=
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# OpenAI project key with a budget (owner). The hub uses it for speech-to-text and text-to-speech.
OPENAI_API_KEY=
# Check the current OpenAI model and voice names before the first voice test.
DOG_STT_MODEL=gpt-4o-mini-transcribe
DOG_TTS_MODEL=gpt-4o-mini-tts
DOG_TTS_VOICE=alloy
DOG_HUB_STATE=/var/lib/doghub
# Daily caps, kept in $DOG_HUB_STATE/usage.json.
DOG_STT_DAILY_MINUTES=30
DOG_TTS_DAILY_CHARS=20000
