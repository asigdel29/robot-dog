# hermes.env: secrets of Hermes Agent. Install it as ~hermes/.hermes/.env (owner hermes, mode 0600).
# scripts/deploy-hub.sh fills API_SERVER_KEY and TOOLS_TOKEN on the first run; the owner adds the other keys.
# Doc: https://hermes-agent.nousresearch.com/docs/reference/environment-variables

# Model provider (owner). Give the key a credit limit in the OpenRouter settings.
OPENROUTER_API_KEY=

# API server for the hub. Loopback only. Doc: user-guide/features/api-server, "Environment Variables".
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=

# Bearer token of the dog tool server; config.yaml reads it as ${TOOLS_TOKEN}.
TOOLS_TOKEN=

# OpenAI key for Telegram voice notes (speech-to-text and text-to-speech).
# Hermes reads VOICE_TOOLS_OPENAI_KEY first for OpenAI voice. Doc: user-guide/features/tts, "Provider Details".
VOICE_TOOLS_OPENAI_KEY=

# Telegram (owner). The bot token comes from BotFather. The allowlist takes numeric user ids, comma-separated.
# Doc: user-guide/messaging/telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
