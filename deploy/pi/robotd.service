# robotd.service: runs robotd, the only process that talks to the IR bridge.
# Type=notify with WatchdogSec=2: robotd sends WATCHDOG=1 each loop tick, so a stopped loop causes a restart.

[Unit]
Description=Robot dog control loop (robotd)
PartOf=dog.target
StartLimitIntervalSec=0

[Service]
Type=notify
WatchdogSec=2
User=dog
Group=dog
ExecStart=/opt/dog/current/.venv/bin/python /opt/dog/current/pi/robotd.py --config /etc/dog/dog.toml
Restart=always
RestartSec=1
Environment=PYTHONUNBUFFERED=1
# robotd needs dialout (serial port) and doglink (cloud socket group) from the dog user's groups.
# It makes no network connection, so it gets unix sockets only.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/dog
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
