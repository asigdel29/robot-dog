# link.env: settings and secret of linkd. Postinstall copies it to /etc/dog/link.env (doglink, mode 0600).
# DOG_DEVICE_TOKEN must be the same value as DEVICE_TOKEN in /etc/doghub/hub.env on the droplet.
# linkd refuses a ws:// URL unless it points at loopback.
DOG_HUB_URL=wss://dog.example.com/device
DOG_DEVICE_TOKEN=
DOG_DEVICE=dog-01
